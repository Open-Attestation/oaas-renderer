{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "Mindef/CertificateOfService",
    "type": "object",
    "required": [
        "name",
        "referenceNo",
        "issueDate",
        "signeeName",
        "signeeDesignation",
        "signeeDepartment",
        "signeeSignature_image"
    ],
    "properties": {
        "name": {
            "type": "string",
            "description": "Name of participant",
            "examples": ["Johnathan Doe"],
            "minLength": 1
        },
        "referenceNo": {
            "type": "string",
            "description": "Reference number",
            "examples": ["0034567"],
            "minLength": 1
        },
        "issueDate": {
            "type": "string",
            "description": "Date of Issue",
            "examples": ["2024-08-20"],
            "format": "date"
        },
        "signeeName": {
            "type": "string",
            "description": "Name of signee",
            "examples": ["LTC SAMPLE NAME"],
            "minLength": 1
        },
        "signeeDesignation": {
            "type": "string",
            "description": "Designation of signee",
            "examples": ["Head MINDEF/SAF"],
            "minLength": 1
        },
        "signeeDepartment": {
            "type": "string",
            "description": "Department of signee",
            "examples": ["Human Resource Shared Services Centre"],
            "minLength": 1
        },
        "signeeSignature_image": {
            "type": "string",
            "description": "Signature of signee",
            "examples": ["signature.png"],
            "minLength": 1
        }
    },
    "additionalProperties": false
}
