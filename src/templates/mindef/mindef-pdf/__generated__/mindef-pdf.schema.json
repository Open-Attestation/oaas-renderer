{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "Mindef/MindefPdf",
    "type": "object",
    "required": ["name", "documentName", "referenceNo", "input_pdf"],
    "properties": {
        "name": {
            "type": "string",
            "description": "Name of participant",
            "examples": ["Johnathan Doe"],
            "minLength": 1
        },
        "documentName": {
            "type": "string",
            "description": "Name of this document",
            "enum": [
                "Certificate of Service Package",
                "Certificate of Service",
                "Transcript",
                "Testimonial",
                "Transcript and Testimonial"
            ],
            "examples": ["Certificate of Service Package"]
        },
        "referenceNo": {
            "type": "string",
            "description": "Reference number",
            "examples": ["0034567"],
            "minLength": 1
        },
        "input_pdf": {
            "type": "string",
            "description": "input pdf filename",
            "examples": ["input.pdf"],
            "minLength": 1
        }
    },
    "additionalProperties": false
}
