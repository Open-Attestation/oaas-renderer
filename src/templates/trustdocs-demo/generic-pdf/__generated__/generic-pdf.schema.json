{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "TrustdocsDemo/GenericPdf",
    "type": "object",
    "required": ["name", "input_pdf"],
    "properties": {
        "name": {
            "type": "string",
            "description": "Name of participant",
            "examples": ["Johnathan Doe"],
            "minLength": 1
        },
        "input_pdf": {
            "type": "string",
            "description": "input pdf filename",
            "examples": ["input.pdf"],
            "minLength": 1
        }
    },
    "additionalProperties": false
}
