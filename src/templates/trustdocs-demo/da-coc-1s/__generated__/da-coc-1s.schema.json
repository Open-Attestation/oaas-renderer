{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "TrustdocsDemo/DaCoc_1s",
    "type": "object",
    "required": [
        "name",
        "programmeTitle",
        "issueDate",
        "signeeName",
        "signeeDesignation",
        "signeeDivision",
        "signeeOrganisation",
        "signeeSignature"
    ],
    "properties": {
        "name": {
            "type": "string",
            "description": "Name of participant",
            "examples": ["SAMPLE_NAME1"],
            "minLength": 1
        },
        "programmeTitle": {
            "type": "string",
            "description": "Title of the programme",
            "examples": [
                "Certified ScrumMaster (CSM) + Certified LeSS Basics (CLB) Workshop"
            ],
            "minLength": 1
        },
        "issueDate": {
            "type": "string",
            "description": "Date of issue",
            "examples": ["2022-05-10"],
            "format": "date"
        },
        "signeeName": {
            "type": "string",
            "description": "Name of signee",
            "enum": ["Sample_name2"],
            "examples": ["Sample_name2"]
        },
        "signeeDesignation": {
            "type": "string",
            "description": "Designation of signee",
            "enum": ["Director"],
            "examples": ["Director"]
        },
        "signeeDivision": {
            "type": "string",
            "description": "Division of signee",
            "enum": ["GovTech Digital Academy"],
            "examples": ["GovTech Digital Academy"]
        },
        "signeeOrganisation": {
            "type": "string",
            "description": "Organisation of signee",
            "enum": ["Government Technology Agency"],
            "examples": ["Government Technology Agency"]
        },
        "signeeSignature": {
            "type": "string",
            "description": "SHA256 hash of the signee's signature",
            "enum": [
                "demo_signature&73dc9d9d6712302c945fbb91d91cc65ef20f6b0d60a0665defbf7d418a506d33.png"
            ],
            "examples": [
                "demo_signature&73dc9d9d6712302c945fbb91d91cc65ef20f6b0d60a0665defbf7d418a506d33.png"
            ]
        }
    },
    "additionalProperties": false
}
