{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "HealthSciencesAuthority/HsaShareCertificate",
    "type": "object",
    "required": [
        "organisationName",
        "documentName",
        "documentReference",
        "signatoryName",
        "signatoryDesignation",
        "agencyName",
        "expireOn",
        "pdfContent_pdf"
    ],
    "properties": {
        "organisationName": {
            "type": "string",
            "description": "Name of the receiving oraganisation",
            "examples": ["ABC PTE LTD"],
            "minLength": 1
        },
        "documentName": {
            "type": "string",
            "description": "Document name",
            "examples": ["Free Sale Certificate"],
            "minLength": 1
        },
        "documentReference": {
            "type": "string",
            "description": "Document reference",
            "examples": ["MCELYY00xxx"],
            "minLength": 1
        },
        "signatoryName": {
            "type": "string",
            "description": "Name of SAL officer",
            "examples": ["Thong Yong Jie Andre"],
            "minLength": 1
        },
        "signatoryDesignation": {
            "type": "string",
            "description": "Designation of SAL officer",
            "examples": ["Approving officer"],
            "minLength": 1
        },
        "agencyName": {
            "type": "string",
            "description": "Agency name for the SAL e-apostille",
            "enum": ["Health Sciences Authority"],
            "examples": ["Health Sciences Authority"]
        },
        "expireOn": {
            "type": "string",
            "description": "Expiry date of permit",
            "examples": ["2030-04-20"],
            "format": "date"
        },
        "pdfContent_pdf": {
            "type": "string",
            "description": "input pdf filename or base64 encoded string",
            "examples": ["input.pdf"],
            "minLength": 1
        }
    },
    "additionalProperties": false
}
